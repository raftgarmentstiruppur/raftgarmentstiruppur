# ── Supabase PostgreSQL ───────────────────────────────────────────────────────
# Supabase dashboard → Settings → Database → Connection string → URI mode
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ── Auth.js ───────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-32-char-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# ── Admin seed credentials ────────────────────────────────────────────────────
ADMIN_EMAIL="admin@draftgarments.com"
ADMIN_PASSWORD="Admin@Draft2025!"

# ── Resend email (optional — forms still work without this) ───────────────────
# Get free API key at resend.com (100 emails/day free)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
RESEND_FROM="no-reply@draftgarments.com"
ADMIN_NOTIFY_EMAIL="admin@draftgarments.com"
